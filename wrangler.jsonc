{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sheridan-open-house-chat",
  "main": "worker/index.js",
  "kv_namespaces": [
    {
      "binding": "GEMINI_KEY_STATE",
      "id": "44e5c457ae4a4ac6b706f910b6cff388"
    }
  ],
  "compatibility_date": "2026-10-01",
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "ALLOWED_ORIGIN": "http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,https://cynthia1211.github.io"
  }
}
